# Copy to terraform.tfvars (NEVER COMMIT terraform.tfvars if it contains secrets).
project_name   = "demo-app"
env            = "dev"
region         = "eu-west-1"
instance_count = 2

tags = {
  team = "platform"
  cost = "shared"
}

subnet_config = {
  app-a = { cidr_block = "10.0.10.0/24", public = false }
  app-b = { cidr_block = "10.0.11.0/24", public = false }
  pub-a = { cidr_block = "10.0.20.0/24", public = true }
}

# Prefer:  export TF_VAR_db_password='...'  instead of writing it here.
# db_password = "supersecret"
