{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "description": "", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }
  ],
  "annotations": { "list": [] },
  "description": "SLO burn-rate alerts — 5% and 2% error budget burn windows (Google SRE alerting model)",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "SLO Definition — 99.5% Availability Target",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Fraction of successful requests over the trailing 30 days",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.99 },
              { "color": "green",  "value": 0.995 }
            ]
          },
          "unit": "percentunit",
          "min": 0.95,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "1 - (sum(rate(demo_requests_total{status=~\"5..\",namespace=\"obs-demo\"}[30d])) / sum(rate(demo_requests_total{namespace=\"obs-demo\"}[30d])))",
          "legendFormat": "30d SLO",
          "refId": "A"
        }
      ],
      "title": "Current SLO — 30d Availability",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Error budget remaining as a fraction. 1.0 = full budget intact. Below 0 = SLO breach.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "green",  "value": 0.50 }
            ]
          },
          "unit": "percentunit",
          "min": -0.5,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "1 - ((1 - (1 - (sum(rate(demo_requests_total{status=~\"5..\",namespace=\"obs-demo\"}[30d])) / sum(rate(demo_requests_total{namespace=\"obs-demo\"}[30d]))))) / (1 - 0.995))",
          "legendFormat": "Budget remaining",
          "refId": "A"
        }
      ],
      "title": "Error Budget Remaining (SLO = 99.5%)",
      "type": "gauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 10,
      "title": "Multi-window Burn Rate (Page / Ticket thresholds)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Fast burn-rate (1h / 5m windows). Burn rate > 14.4x = page immediately (5% budget in 1h). Burn rate > 6x = ticket.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "14.4x PAGE threshold" }, "properties": [{ "id": "color", "value": { "fixedColor": "#F2495C", "mode": "fixed" } }, { "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }] },
          { "matcher": { "id": "byName", "options": "6x TICKET threshold" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }, { "id": "custom.lineStyle", "value": { "dash": [5, 5], "fill": "dash" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(sum(rate(demo_requests_total{status=~\"5..\",namespace=\"obs-demo\"}[1h])) / sum(rate(demo_requests_total{namespace=\"obs-demo\"}[1h]))) / (1 - 0.995)",
          "legendFormat": "1h burn rate",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(sum(rate(demo_requests_total{status=~\"5..\",namespace=\"obs-demo\"}[5m])) / sum(rate(demo_requests_total{namespace=\"obs-demo\"}[5m]))) / (1 - 0.995)",
          "legendFormat": "5m burn rate",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "vector(14.4)",
          "legendFormat": "14.4x PAGE threshold",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "vector(6)",
          "legendFormat": "6x TICKET threshold",
          "refId": "D"
        }
      ],
      "title": "Fast Burn Windows — 1h + 5m (5% budget in 1h = PAGE)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Slow burn-rate (6h / 30m windows). Burn rate > 6x = ticket. Budget consumption: 2% in 6h.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5 },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "3x WARN threshold" }, "properties": [{ "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }, { "id": "custom.lineStyle", "value": { "dash": [5, 5], "fill": "dash" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(sum(rate(demo_requests_total{status=~\"5..\",namespace=\"obs-demo\"}[6h])) / sum(rate(demo_requests_total{namespace=\"obs-demo\"}[6h]))) / (1 - 0.995)",
          "legendFormat": "6h burn rate",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "(sum(rate(demo_requests_total{status=~\"5..\",namespace=\"obs-demo\"}[30m])) / sum(rate(demo_requests_total{namespace=\"obs-demo\"}[30m]))) / (1 - 0.995)",
          "legendFormat": "30m burn rate",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "vector(3)",
          "legendFormat": "3x WARN threshold",
          "refId": "C"
        }
      ],
      "title": "Slow Burn Windows — 6h + 30m (2% budget in 6h = TICKET)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 30,
      "title": "Error Budget Burn — Time to Exhaustion",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "How many hours remain before the 30-day error budget is exhausted at the current burn rate",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "h",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 72 },
              { "color": "green",  "value": 168 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 19 },
      "id": 6,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "((1 - (sum(rate(demo_requests_total{status=~\"5..\",namespace=\"obs-demo\"}[1h])) / sum(rate(demo_requests_total{namespace=\"obs-demo\"}[1h])))) / (1 - 0.995)) * 720",
          "legendFormat": "Hours to budget exhaustion",
          "refId": "A"
        }
      ],
      "title": "Time to Error Budget Exhaustion (at current 1h burn rate)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Cumulative error count in the 30-day window vs the allowed budget",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 19 },
      "id": 7,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "increase(demo_requests_total{status=~\"5..\",namespace=\"obs-demo\"}[30d])",
          "legendFormat": "Actual errors (30d)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "increase(demo_requests_total{namespace=\"obs-demo\"}[30d]) * (1 - 0.995)",
          "legendFormat": "Allowed budget (30d)",
          "refId": "B"
        }
      ],
      "title": "Error Budget — Actual vs Allowed (30d)",
      "type": "timeseries"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["slo", "burn-rate", "sre"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SLO Burn-Rate — obs-demo",
  "uid": "obs-slo-burn",
  "version": 1
}
