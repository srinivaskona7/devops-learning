{
  "__inputs": [
    { "name": "DS_PROMETHEUS", "label": "Prometheus", "description": "", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" },
    { "name": "DS_LOKI",       "label": "Loki",       "description": "", "type": "datasource", "pluginId": "loki",       "pluginName": "Loki" },
    { "name": "DS_TEMPO",      "label": "Tempo",      "description": "", "type": "datasource", "pluginId": "tempo",      "pluginName": "Tempo" }
  ],
  "annotations": { "list": [] },
  "description": "Google SRE Four Golden Signals — Rate, Errors, Duration, Saturation with exemplar trace links",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Rate — requests/s",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Total request throughput by endpoint (Four Golden Signals: Rate)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (endpoint) (rate(demo_requests_total{namespace=\"obs-demo\"}[$__rate_interval]))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate by Endpoint",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Four Golden Signals: Errors — HTTP 5xx rate",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#F2495C", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 20, "showPoints": "never" },
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (endpoint) (rate(demo_requests_total{namespace=\"obs-demo\",status=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "errors {{endpoint}}",
          "refId": "A"
        }
      ],
      "title": "Error Rate (5xx) by Endpoint",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 10,
      "title": "Duration — latency percentiles",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Four Golden Signals: Duration — p50/p95/p99 latency with exemplar links to Tempo traces",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum by (le, endpoint) (rate(demo_request_duration_seconds_bucket{namespace=\"obs-demo\"}[$__rate_interval])))",
          "legendFormat": "p50 {{endpoint}}",
          "refId": "A",
          "exemplar": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(demo_request_duration_seconds_bucket{namespace=\"obs-demo\"}[$__rate_interval])))",
          "legendFormat": "p95 {{endpoint}}",
          "refId": "B",
          "exemplar": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum by (le, endpoint) (rate(demo_request_duration_seconds_bucket{namespace=\"obs-demo\"}[$__rate_interval])))",
          "legendFormat": "p99 {{endpoint}}",
          "refId": "C",
          "exemplar": true
        }
      ],
      "title": "Request Latency p50 / p95 / p99 (with Exemplars → Tempo)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Four Golden Signals: Saturation — CPU throttling and memory pressure",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"obs-demo\",container=\"obs-demo\"}[$__rate_interval])) / sum by (pod) (kube_pod_container_resource_limits{namespace=\"obs-demo\",container=\"obs-demo\",resource=\"cpu\"})",
          "legendFormat": "CPU throttle {{pod}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"obs-demo\",container=\"obs-demo\"}) / sum by (pod) (kube_pod_container_resource_limits{namespace=\"obs-demo\",container=\"obs-demo\",resource=\"memory\"})",
          "legendFormat": "Mem usage {{pod}}",
          "refId": "B"
        }
      ],
      "title": "Saturation — CPU & Memory vs Limits",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 20,
      "title": "Logs — correlated via trace_id",
      "type": "row"
    },
    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Live log stream. Click trace_id link → jump to Tempo span.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{service_name=\"obs-demo\",namespace=\"obs-demo\"} |= \"\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Application Logs (Loki) — trace_id linked to Tempo",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["observability", "golden-signals", "otel"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "definition": "label_values(demo_requests_total, namespace)",
        "hide": 0,
        "includeAll": false,
        "label": "Namespace",
        "name": "namespace",
        "options": [],
        "query": { "query": "label_values(demo_requests_total, namespace)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "regex": "",
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Four Golden Signals — obs-demo",
  "uid": "obs-golden-signals",
  "version": 1
}
