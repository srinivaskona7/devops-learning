{
  "type": "excalidraw",
  "version": 2,
  "source": "learnkube-audit",
  "elements": [
    {
      "id": "title-bg",
      "type": "rectangle",
      "x": 200,
      "y": 10,
      "width": 540,
      "height": 60,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "#2b8a3e",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "title-text",
      "type": "text",
      "x": 270,
      "y": 25,
      "text": "HEALTH CHECKS — Reasoning Flow",
      "fontSize": 22,
      "fontFamily": 1,
      "strokeColor": "#ffffff"
    },
    {
      "id": "start",
      "type": "ellipse",
      "x": 30,
      "y": 120,
      "width": 160,
      "height": 70,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "#d3f9d8",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1
    },
    {
      "id": "start-text",
      "type": "text",
      "x": 68,
      "y": 142,
      "text": "Pod Starts",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#2b8a3e"
    },
    {
      "id": "arrow1",
      "type": "arrow",
      "x": 195,
      "y": 155,
      "width": 100,
      "height": 0,
      "strokeColor": "#495057",
      "strokeWidth": 2,
      "roughness": 1,
      "points": [[0, 0], [100, 0]]
    },
    {
      "id": "decision",
      "type": "diamond",
      "x": 300,
      "y": 105,
      "width": 220,
      "height": 100,
      "strokeColor": "#e67700",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1
    },
    {
      "id": "decision-text",
      "type": "text",
      "x": 340,
      "y": 138,
      "text": "Has Readiness\n    Probe?",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#e67700"
    },
    {
      "id": "arrow-yes",
      "type": "arrow",
      "x": 525,
      "y": 140,
      "width": 100,
      "height": 0,
      "strokeColor": "#2b8a3e",
      "strokeWidth": 2,
      "roughness": 1,
      "points": [[0, 0], [100, 0]]
    },
    {
      "id": "yes-label",
      "type": "text",
      "x": 555,
      "y": 120,
      "text": "YES",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#2b8a3e"
    },
    {
      "id": "yes-box",
      "type": "rectangle",
      "x": 630,
      "y": 110,
      "width": 300,
      "height": 60,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "#d3f9d8",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "yes-text",
      "type": "text",
      "x": 645,
      "y": 125,
      "text": "Kubelet gates traffic\nRoutes only when ready",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#2b8a3e"
    },
    {
      "id": "arrow-no",
      "type": "arrow",
      "x": 410,
      "y": 210,
      "width": 0,
      "height": 50,
      "strokeColor": "#c92a2a",
      "strokeWidth": 2,
      "roughness": 1,
      "points": [[0, 0], [0, 50]]
    },
    {
      "id": "no-label",
      "type": "text",
      "x": 420,
      "y": 220,
      "text": "NO",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#c92a2a"
    },
    {
      "id": "no-box",
      "type": "rectangle",
      "x": 290,
      "y": 265,
      "width": 280,
      "height": 60,
      "strokeColor": "#c92a2a",
      "backgroundColor": "#ffe3e3",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "no-text",
      "type": "text",
      "x": 305,
      "y": 275,
      "text": "Traffic hits immediately!\n2min startup = 2min of 500 errors",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#c92a2a"
    },
    {
      "id": "probe-readiness",
      "type": "rectangle",
      "x": 30,
      "y": 380,
      "width": 280,
      "height": 150,
      "strokeColor": "#1864ab",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "probe-readiness-text",
      "type": "text",
      "x": 45,
      "y": 390,
      "text": "READINESS PROBE\n-----------------------\nPurpose: Gate traffic\nEffect: Remove from Service\nKey: Must be INDEPENDENT\n  No DB / API dependencies!\nRisk: Cascading failures",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#1864ab"
    },
    {
      "id": "probe-liveness",
      "type": "rectangle",
      "x": 350,
      "y": 380,
      "width": 280,
      "height": 150,
      "strokeColor": "#e8590c",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "probe-liveness-text",
      "type": "text",
      "x": 365,
      "y": 390,
      "text": "LIVENESS PROBE\n-----------------------\nPurpose: Restart stuck pods\nEffect: Kill + restart\nKey: Passive — always OK\n  Endpoint always returns 200\nRisk: Same as readiness = bad",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#e8590c"
    },
    {
      "id": "probe-startup",
      "type": "rectangle",
      "x": 670,
      "y": 380,
      "width": 280,
      "height": 150,
      "strokeColor": "#862e9c",
      "backgroundColor": "#f8f0fc",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "probe-startup-text",
      "type": "text",
      "x": 685,
      "y": 390,
      "text": "STARTUP PROBE\n-----------------------\nPurpose: Slow-start apps\nEffect: Delay liveness\nKey: Use for Java/heavy init\nNote: NOT deeply covered\n  on LearnKube page",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#862e9c"
    },
    {
      "id": "critical-bg",
      "type": "rectangle",
      "x": 30,
      "y": 575,
      "width": 600,
      "height": 65,
      "strokeColor": "#c92a2a",
      "backgroundColor": "#fff5f5",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "critical-text",
      "type": "text",
      "x": 45,
      "y": 585,
      "text": "CRITICAL: Never point readiness & liveness to SAME endpoint!\nKubelet removes from Service AND kills simultaneously -> dropped connections",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#c92a2a"
    },
    {
      "id": "summary-bg",
      "type": "rectangle",
      "x": 670,
      "y": 555,
      "width": 280,
      "height": 130,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "summary-text",
      "type": "text",
      "x": 685,
      "y": 565,
      "text": "BEST PRACTICES:\n1. Always set readiness\n2. Crash on fatal errors\n3. Liveness = passive /healthz\n4. Keep probes INDEPENDENT\n5. Different values each",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#2b8a3e"
    }
  ],
  "appState": { "viewBackgroundColor": "#ffffff" }
}
