{
  "type": "excalidraw",
  "version": 2,
  "source": "learnkube-audit",
  "elements": [
    {
      "id": "title-bg",
      "type": "rectangle",
      "x": 150,
      "y": 10,
      "width": 650,
      "height": 60,
      "strokeColor": "#5f3dc4",
      "backgroundColor": "#5f3dc4",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "title-text",
      "type": "text",
      "x": 180,
      "y": 25,
      "text": "GRACEFUL SHUTDOWN — Pod Deletion Sequence",
      "fontSize": 22,
      "fontFamily": 1,
      "strokeColor": "#ffffff"
    },
    {
      "id": "trigger",
      "type": "ellipse",
      "x": 30,
      "y": 110,
      "width": 230,
      "height": 65,
      "strokeColor": "#5f3dc4",
      "backgroundColor": "#f3f0ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1
    },
    {
      "id": "trigger-text",
      "type": "text",
      "x": 55,
      "y": 128,
      "text": "kubectl delete pod/my-app",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#5f3dc4"
    },
    {
      "id": "arrow-to-api",
      "type": "arrow",
      "x": 265,
      "y": 142,
      "width": 80,
      "height": 0,
      "strokeColor": "#495057",
      "strokeWidth": 2,
      "roughness": 1,
      "points": [[0, 0], [80, 0]]
    },
    {
      "id": "api",
      "type": "rectangle",
      "x": 355,
      "y": 110,
      "width": 290,
      "height": 60,
      "strokeColor": "#5f3dc4",
      "backgroundColor": "#e5dbff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "api-text",
      "type": "text",
      "x": 375,
      "y": 128,
      "text": "API Server marks Pod Terminating",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#5f3dc4"
    },
    {
      "id": "parallel-label",
      "type": "text",
      "x": 410,
      "y": 180,
      "text": "HAPPENS IN PARALLEL",
      "fontSize": 12,
      "fontFamily": 1,
      "strokeColor": "#c92a2a"
    },
    {
      "id": "arrow-to-A",
      "type": "arrow",
      "x": 420,
      "y": 175,
      "width": -200,
      "height": 60,
      "strokeColor": "#1864ab",
      "strokeWidth": 2,
      "roughness": 1,
      "points": [[0, 0], [-200, 60]]
    },
    {
      "id": "arrow-to-B",
      "type": "arrow",
      "x": 575,
      "y": 175,
      "width": 200,
      "height": 60,
      "strokeColor": "#e8590c",
      "strokeWidth": 2,
      "roughness": 1,
      "points": [[0, 0], [200, 60]]
    },
    {
      "id": "pathA",
      "type": "rectangle",
      "x": 30,
      "y": 240,
      "width": 360,
      "height": 80,
      "strokeColor": "#1864ab",
      "backgroundColor": "#e7f5ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "pathA-text",
      "type": "text",
      "x": 50,
      "y": 252,
      "text": "PATH A: Endpoint Removal\nkube-proxy / Ingress removes Pod\nfrom Service endpoints (takes time!)",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#1864ab"
    },
    {
      "id": "pathB",
      "type": "rectangle",
      "x": 560,
      "y": 240,
      "width": 360,
      "height": 80,
      "strokeColor": "#e8590c",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "pathB-text",
      "type": "text",
      "x": 580,
      "y": 252,
      "text": "PATH B: SIGTERM Sent\nKubelet sends SIGTERM to PID 1\n(grace period: 30s default)",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#e8590c"
    },
    {
      "id": "race-bg",
      "type": "rectangle",
      "x": 30,
      "y": 350,
      "width": 450,
      "height": 65,
      "strokeColor": "#c92a2a",
      "backgroundColor": "#fff5f5",
      "fillStyle": "solid",
      "strokeWidth": 3,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "race-text",
      "type": "text",
      "x": 50,
      "y": 360,
      "text": "!! RACE CONDITION !!\nTraffic may STILL arrive after SIGTERM — propagation lag!",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#c92a2a"
    },
    {
      "id": "correct-bg",
      "type": "rectangle",
      "x": 30,
      "y": 450,
      "width": 420,
      "height": 180,
      "strokeColor": "#2b8a3e",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "correct-text",
      "type": "text",
      "x": 50,
      "y": 460,
      "text": "CORRECT SHUTDOWN SEQUENCE\n-----------------------------------\n1. Receive SIGTERM\n2. Stop accepting NEW connections\n3. Complete all ACTIVE requests\n4. Close idle keep-alive sockets\n5. Exit process cleanly\n\n+ preStop hook: sleep(5s) to handle race",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#2b8a3e"
    },
    {
      "id": "wrong-bg",
      "type": "rectangle",
      "x": 510,
      "y": 450,
      "width": 420,
      "height": 180,
      "strokeColor": "#c92a2a",
      "backgroundColor": "#fff5f5",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "wrong-text",
      "type": "text",
      "x": 530,
      "y": 460,
      "text": "WRONG APPROACHES\n-----------------------------------\nx  Immediate process.exit(0)\n   -> Drops in-flight requests\n\nx  Shell as PID 1 (traps SIGTERM)\n   -> Container killed at 30s timeout\n\nx  Keep-alive sockets left open\n   -> Clients route to dead pod",
      "fontSize": 13,
      "fontFamily": 1,
      "strokeColor": "#c92a2a"
    },
    {
      "id": "key-bg",
      "type": "rectangle",
      "x": 150,
      "y": 665,
      "width": 650,
      "height": 55,
      "strokeColor": "#e67700",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "roughness": 1,
      "roundness": { "type": 3 }
    },
    {
      "id": "key-text",
      "type": "text",
      "x": 175,
      "y": 675,
      "text": "KEY INSIGHT: Use CMD [\"node\",\"app.js\"] NOT CMD node app.js\nShell form wraps in /bin/sh which TRAPS the SIGTERM signal!",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#e67700"
    }
  ],
  "appState": { "viewBackgroundColor": "#ffffff" }
}
