# .env.example — copy to .env and fill in real values.
# NEVER commit .env to version control.
#
# Usage:
#   cp infra/.env.example infra/.env
#   # edit .env
#   make up

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=shortener
POSTGRES_PASSWORD=changeme_use_a_strong_password_here
POSTGRES_DB=shortener

# ── API (constructed from above — do not change the format) ──────────────
# DATABASE_URL is built by docker-compose.yml from the values above.
# You do not need to set it manually.

# ── Optional: expose Adminer on host ─────────────────────────────────────
# Uncomment and add to the adminer service ports section if needed:
# ADMINER_HOST_PORT=8081
